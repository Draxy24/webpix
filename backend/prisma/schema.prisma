generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int              @id @default(autoincrement())
  email            String?          @unique
  phone            String?          @unique
  nickname         String           @unique
  passwordHash     String
  verified         Boolean          @default(false)
  profilePic       String?
  subscriptionTier SubscriptionTier @default(FREE)
  isAdmin          Boolean          @default(false)
  pixelsUsed       Int              @default(0)
  cooldownUntil    DateTime?
  createdAt        DateTime         @default(now())
  country String?
  verificationCodes VerificationCode[]
  bannedUntil  DateTime?
  banPermanent Boolean   @default(false)
  banReason    String?

  pixels          Pixel[]
  friendsSent     Friendship[]     @relation("FriendsSent")
  friendsReceived Friendship[]     @relation("FriendsReceived")
  publications         Publication[]
  publicationReactions PublicationReaction[]
  publicationComments  PublicationComment[]
}

model Pixel {
  id        Int      @id @default(autoincrement())
  x         Int
  y         Int
  color     String
  paintedAt DateTime @default(now())
  userId    Int?

  user      User?    @relation(fields: [userId], references: [id])

  @@unique([x, y])
}

model Friendship {
  id         Int              @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  sender     User @relation("FriendsSent", fields: [senderId], references: [id])
  receiver   User @relation("FriendsReceived", fields: [receiverId], references: [id])
}

enum SubscriptionTier {
  FREE
  PLUS
  PREMIUM
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Publication {
  id          Int                   @id @default(autoincrement())
  userId      Int
  title       String?
  x1          Int
  y1          Int
  x2          Int
  y2          Int
  pixelData   Json
  createdAt   DateTime              @default(now())

  user        User                  @relation(fields: [userId], references: [id])
  reactions   PublicationReaction[]
  comments    PublicationComment[]
}

model PublicationReaction {
  id            Int          @id @default(autoincrement())
  publicationId Int
  userId        Int
  type          ReactionType
  createdAt     DateTime     @default(now())

  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])

  @@unique([publicationId, userId])
}

model PublicationComment {
  id            Int         @id @default(autoincrement())
  publicationId Int
  userId        Int
  content       String
  createdAt     DateTime    @default(now())

  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])
}

enum ReactionType {
  LIKE
  DISLIKE
}

model VerificationCode {
  id        Int              @id @default(autoincrement())
  userId    Int
  code      String
  type      VerificationType
  expiresAt DateTime
  createdAt DateTime         @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum VerificationType {
  EMAIL
  PHONE
  PASSWORD_RESET
}

model Report {
  id            Int          @id @default(autoincrement())
  type          ReportType
  reporterId    Int
  targetUserId  Int?
  publicationId Int?
  commentId     Int?
  reason        String
  details       String?
  status        ReportStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?
  resolvedById  Int?
}

model ModerationAction {
  id           Int      @id @default(autoincrement())
  moderatorId  Int
  action       String
  targetUserId Int?
  details      String?
  createdAt    DateTime @default(now())
}

enum ReportType {
  USER
  PUBLICATION
  COMMENT
  BUG
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}