generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int              @id @default(autoincrement())
  email            String?          @unique
  phone            String?          @unique
  nickname         String           @unique
  passwordHash     String
  verified         Boolean          @default(false)
  profilePic       String?
  subscriptionTier SubscriptionTier @default(FREE)
  isAdmin          Boolean          @default(false)
  pixelsUsed       Int              @default(0)
  cooldownUntil    DateTime?
  createdAt        DateTime         @default(now())
  country String?
  verificationCodes VerificationCode[]
  bannedUntil  DateTime?
  banPermanent Boolean   @default(false)
  banReason    String?
  bits  Int @default(0)
  xp    Int @default(0)
  level Int @default(1)
  pixelsPlaced        Int @default(0)
  publicationsCreated Int @default(0)
  likesReceived       Int @default(0)
  stripeCustomerId String? @unique

  pixels          Pixel[]
  friendsSent     Friendship[]     @relation("FriendsSent")
  friendsReceived Friendship[]     @relation("FriendsReceived")
  publications         Publication[]
  publicationReactions PublicationReaction[]
  publicationComments  PublicationComment[]
  privateSpaces      PrivateSpace[]
  privateSpaceAccess PrivateSpaceMember[]
  cosmetics UserCosmetic[]
  achievements UserAchievement[]
  weeklyTasks UserWeeklyTask[]
  monthlyScores MonthlyScore[]
  rankingWins RankingWinner[]
  announcements Announcement[]
}

model Pixel {
  id        Int      @id @default(autoincrement())
  x         Int
  y         Int
  color     String
  paintedAt DateTime @default(now())
  userId    Int?

  user      User?    @relation(fields: [userId], references: [id])

  @@unique([x, y])
}

model Friendship {
  id         Int              @id @default(autoincrement())
  senderId   Int
  receiverId Int
  status     FriendshipStatus @default(PENDING)
  createdAt  DateTime         @default(now())

  sender     User @relation("FriendsSent", fields: [senderId], references: [id])
  receiver   User @relation("FriendsReceived", fields: [receiverId], references: [id])
}

enum SubscriptionTier {
  FREE
  PLUS
  PREMIUM
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Publication {
  id          Int                   @id @default(autoincrement())
  userId      Int
  title       String?
  x1          Int
  y1          Int
  x2          Int
  y2          Int
  pixelData   Json
  createdAt   DateTime              @default(now())

  user        User                  @relation(fields: [userId], references: [id])
  reactions   PublicationReaction[]
  comments    PublicationComment[]
}

model PublicationReaction {
  id            Int          @id @default(autoincrement())
  publicationId Int
  userId        Int
  type          ReactionType
  createdAt     DateTime     @default(now())

  publication   Publication  @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])

  @@unique([publicationId, userId])
}

model PublicationComment {
  id            Int         @id @default(autoincrement())
  publicationId Int
  userId        Int
  content       String
  createdAt     DateTime    @default(now())

  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id])
}

enum ReactionType {
  LIKE
  DISLIKE
}

model VerificationCode {
  id        Int              @id @default(autoincrement())
  userId    Int
  code      String
  type      VerificationType
  expiresAt DateTime
  createdAt DateTime         @default(now())
  attempts Int @default(0)

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum VerificationType {
  EMAIL
  PHONE
  PASSWORD_RESET
}

model Report {
  id            Int          @id @default(autoincrement())
  type          ReportType
  reporterId    Int
  targetUserId  Int?
  publicationId Int?
  commentId     Int?
  x1            Int?
  y1            Int?
  x2            Int?
  y2            Int?
  reason        String
  details       String?
  status        ReportStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?
  resolvedById  Int?
}

model ModerationAction {
  id           Int      @id @default(autoincrement())
  moderatorId  Int
  action       String
  targetUserId Int?
  details      String?
  createdAt    DateTime @default(now())
}

enum ReportType {
  USER
  PUBLICATION
  COMMENT
  BUG
  CANVAS
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

model PrivateSpace {
  id             Int                  @id @default(autoincrement())
  ownerId        Int
  name           String?
  x1             Int
  y1             Int
  x2             Int
  y2             Int
  accessMode     PrivateSpaceAccess   @default(OWNER_ONLY)
  purchaseType   PurchaseType
  pricePaidCents Int
  expiresAt      DateTime?            // null = permanente; con fecha = renta mensual
  createdAt      DateTime             @default(now())

  owner          User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members        PrivateSpaceMember[]
}

model PrivateSpaceMember {
  id        Int          @id @default(autoincrement())
  spaceId   Int
  userId    Int
  createdAt DateTime     @default(now())

  space     PrivateSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
}

enum PrivateSpaceAccess {
  OWNER_ONLY
  FRIENDS
  SPECIFIC
}

enum PurchaseType {
  MONTHLY
  PERMANENT
}

model Cosmetic {
  id          Int            @id @default(autoincrement())
  type        CosmeticType
  key         String         @unique
  name        String
  description String?
  source      CosmeticSource
  priceBits   Int?
  rarity      CosmeticRarity?
  data        Json?
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  theme String?

  unlocks     UserCosmetic[]
}

model UserCosmetic {
  id         Int      @id @default(autoincrement())
  userId     Int
  cosmeticId Int
  equipped   Boolean  @default(false)
  unlockedAt DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cosmetic   Cosmetic @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)

  @@unique([userId, cosmeticId])
}

enum CosmeticType {
  TITLE
  BADGE
  FRAME
  BACKGROUND
  COLOR
}

enum CosmeticSource {
  ACHIEVEMENT
  TASK
  RANKING
  EVENT
  SHOP
}

model Achievement {
  id                Int               @id @default(autoincrement())
  key               String            @unique
  name              String
  description       String?
  metric            AchievementMetric
  threshold         Int
  rewardXp          Int               @default(0)
  rewardBits        Int               @default(0)
  rewardCosmeticKey String?
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())

  unlocks           UserAchievement[]
}

model UserAchievement {
  id            Int      @id @default(autoincrement())
  userId        Int
  achievementId Int
  completedAt   DateTime @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

enum AchievementMetric {
  PIXELS_PLACED
  PUBLICATIONS_CREATED
  LIKES_RECEIVED
  LEVEL_REACHED
  COSMETICS_OWNED
  LEGENDARY_OWNED
  MYTHIC_OWNED
  PALETTE_COMPLETED
  FRIENDS
}

model WeeklyTask {
  id                Int               @id @default(autoincrement())
  key               String            @unique
  name              String
  description       String?
  metric            AchievementMetric
  threshold         Int
  rewardXp          Int               @default(0)
  rewardBits        Int               @default(0)
  rewardCosmeticKey String?
  active            Boolean           @default(true)
  createdAt         DateTime          @default(now())

  progress          UserWeeklyTask[]
}

model UserWeeklyTask {
  id           Int       @id @default(autoincrement())
  userId       Int
  weeklyTaskId Int
  weekKey      String
  progress     Int       @default(0)
  completed    Boolean   @default(false)
  completedAt  DateTime?

  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyTask   WeeklyTask @relation(fields: [weeklyTaskId], references: [id], onDelete: Cascade)

  @@unique([userId, weeklyTaskId, weekKey])
}

enum CosmeticRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
}

model MonthlyScore {
  id        Int    @id @default(autoincrement())
  userId    Int
  period    String // "2026-06" (año-mes UTC)
  pixels    Int    @default(0)
  creations Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
}

model RankingWinner {
  id          Int      @id @default(autoincrement())
  period      String   // "2026-06"
  metric      String   // "pixels" | "creations"
  scope       String   // "global" | "national"
  country     String?  // ISO-2 si es nacional
  position    Int      // 1..10
  userId      Int
  score       Int      // conteo al cierre
  bitsAwarded Int
  seen        Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([period])
  @@index([userId])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  authorId  Int?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([pinned, createdAt])
}

model CanvasSnapshot {
  id        Int      @id @default(autoincrement())
  weekStart DateTime @unique
  imageUrl  String
  createdAt DateTime @default(now())
}

model ProcessedStripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}